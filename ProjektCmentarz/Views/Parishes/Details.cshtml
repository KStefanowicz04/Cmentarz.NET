@model ProjektCmentarz.Models.Parish
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    var priests = (IPagedList<ProjektCmentarz.Models.Priest>)ViewBag.Priests;
    ViewData["Title"] = $"Parafia {Model.Name}";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3 mb-5 bg-light text-dark p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="text-uppercase text-muted fw-bold small">Szczegóły obiektu</span>
                <h1 class="display-6 fw-bold m-0 text-primary">Parafia: @Model.Name</h1>
            </div>
            <div class="d-flex gap-2">
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4 rounded-pill shadow-sm">Edytuj</a>
                }
                <a asp-action="Index" class="btn btn-secondary px-4 rounded-pill shadow-sm">Powrót do listy</a>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <h3 class="fw-bold text-dark border-bottom pb-2 mb-4">Duszpasterze pracujący w parafii</h3>
    </div>

    @if (priests == null || !priests.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-3 p-4" role="alert">
            <h5 class="alert-heading fw-bold">Brak danych</h5>
            <p class="m-0">Aktualnie do tej parafii nie zostali przypisani żadni księża w systemie.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
            @foreach (var priest in priests)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 border-top border-4 border-info rounded-3">
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="card-title text-center fw-bold text-dark mb-1">@priest.FirstName</h5>
                                <h5 class="card-title text-center fw-bold text-dark mb-3">@priest.Surname</h5>
                                <p class="card-text text-muted text-center small mb-0">ID duchownego: #@priest.Id</p>
                            </div>
                            
                            <div class="mt-4 text-center">
                                <a asp-controller="Priests" asp-action="Details" asp-route-id="@priest.Id" class="btn btn-outline-info btn-sm w-100 rounded-pill">
                                    Zobacz profil
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-center mt-5">
            @Html.PagedListPager(
                priests,
                page => Url.Action("Details", new { id = Model.Id, page }),
                new PagedListRenderOptions
                {
                    DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                    DisplayLinkToLastPage = PagedListDisplayMode.Never,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                    UlElementClasses = new[] { "pagination", "pagination-md", "shadow-sm" },
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                }
            )
        </div>
    }
</div>