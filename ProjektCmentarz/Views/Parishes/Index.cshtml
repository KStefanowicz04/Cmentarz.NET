@model IEnumerable<ProjektCmentarz.Models.Parish>

@{
    ViewData["Title"] = "Lista Parafii";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="display-5 text-dark fw-bold m-0">Lista Współpracujących Parafii</h1>
        
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
                Dodaj nową parafię
            </a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 rounded-3 hover-shadow transition">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        <div>
                            <span class="badge bg-secondary mb-2">Parafia</span>
                            <h4 class="card-title text-primary fw-semibold mb-3">@item.Name</h4>
                        </div>
                        
                        <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                                Szczegóły
                            </a>
                            
                            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm px-3 rounded-pill">
                                    Edytuj
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                                    Usuń
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15)!important;
        transition: all 0.3s ease-in-out;
    }
    .transition {
        transition: all 0.3s ease-in-out;
    }
</style>