@model IEnumerable<ProjektCmentarz.Models.Parish>

@{
    ViewData["Title"] = "Lista Współpracujących Parafii";
}

<div class="container mt-4 p-0">
    <!-- NAGŁÓWEK -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="display-5 text-dark fw-bold m-0" style="color: inherit !important;">Lista Współpracujących Parafii</h1>
        
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                Dodaj nową parafię
            </a>
        }
    </div>

    <!-- LISTA PARAFII -->
    <div class="d-flex flex-column gap-4">
        @foreach (var item in Model)
        {
            <div class="card shadow-sm border-0 rounded-3 bg-white hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <span class="badge bg-secondary px-2.5 py-1.5 rounded-3 small mb-2 d-inline-block opacity-75 fw-bold" style="font-size: 11px;">Parafia</span>
                        <h4 class="fw-bold text-primary mb-1" style="color: #0d6efd !important;">@item.Name</h4>
                        <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i> Identyfikator w systemie: #@item.Id</p>
                    </div>
                    
                    <div class="d-flex gap-2 align-self-start align-self-md-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-medium">
                            Szczegóły
                        </a>
                        
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning rounded-pill px-3 btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger rounded-pill px-3 btn-sm">
                                <i class="bi bi-trash"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1)!important;
    }
    .transition { transition: all 0.2s ease-in-out; }
</style>