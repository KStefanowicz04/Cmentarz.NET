@model IEnumerable<ProjektCmentarz.Models.Priest>

@{
    ViewData["Title"] = "Lista Duchowieństwa";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="display-5 text-dark fw-bold m-0">Ewidencja Duchowieństwa</h1>
        
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
                Dodaj nowego księdza
            </a>
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-top border-4 border-secondary bg-white rounded-3 hover-shadow transition">
                    <div class="card-body d-flex flex-column justify-content-between p-4">
                        
                        <div class="text-center mb-3">
                            <div class="bg-light text-secondary rounded-circle d-inline-flex align-items-center justify-content-center fw-bold" style="width: 50px; height: 50px; font-size: 18px;">
                                <i class="bi bi-person-vcard"></i>
                            </div>
                        </div>
                        
                        <div class="text-center">
                            <h5 class="card-title fw-bold text-dark mb-1">@item.FirstName</h5>
                            <h5 class="card-title fw-bold text-dark mb-3">@item.Surname</h5>
                            
                            <div class="mt-2 small">
                                <p class="mb-1 text-muted">
                                    <i class="bi bi-bank me-1"></i> 
                                    @(item.Parish != null ? item.Parish.Name : "Brak parafii")
                                </p>
                                <p class="mb-0 text-muted">
                                    <i class="bi bi-telephone me-1"></i> 
                                    @(item.PriestContactData != null ? item.PriestContactData.PhoneNumber : "Brak telefonu")
                                </p>
                            </div>
                        </div>
                        
                        <div class="d-flex flex-column gap-2 mt-4 pt-3 border-top">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                Szczegóły profilu
                            </a>
                            
                            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm flex-grow-1 rounded-pill">
                                        Edytuj
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm flex-grow-1 rounded-pill">
                                        Usuń
                                    </a>
                                </div>
                            }
                        </div>
                        
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Twoje niestandardowe, płynne animacje uniesienia kafelka */
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15)!important;
        transition: all 0.3s ease-in-out;
    }
    .transition {
        transition: all 0.3s ease-in-out;
    }
</style>