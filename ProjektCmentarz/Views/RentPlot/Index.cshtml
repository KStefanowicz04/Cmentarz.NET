@model IEnumerable<ProjektCmentarz.Models.Plot>

@{
    ViewData["Title"] = "Wynajmij działkę";
}

<h1>Wynajmij działkę</h1>

@* Formularz wyszukiwania *@
<div class="card mb-4 shadow-sm">
    <div class="card-body bg-light">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Sekcja cmentarza</label>
                        <select name="sectionId" class="form-select">
                        <option value="">Wszystkie sekcje</option>
                        @foreach (var sec in ViewBag.Sections)
                        {
                            <option value="@sec.Id">@sec.SectionType</option>
                        }
                        </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Szukaj</button>
                </div>
            </div>
            <div class="mt-2 text-end">
                <a asp-action="Index" class="btn btn-sm btn-link text-secondary">Wyczyść filtry</a>
            </div>
        </form>
    </div>
</div>

@* Działki *@
<div class="row">
    @foreach (var plot in Model)
    {
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h4>Działka numer @plot.Id</h4>
                    <p>Sekcja: @plot.GraveyardSection?.SectionType</p>
                    <p>Cena: @plot.PlotValue</p>
                    <a asp-action="Details" asp-route-id="@plot.Id" class="text-danger">Wynajmij</a>
                </div>
            </div>
        </div>
    }
</div>
