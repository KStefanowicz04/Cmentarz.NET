@model IEnumerable<ProjektCmentarz.Models.Grave>

@{
    ViewData["Title"] = "Rejestr Grobów";
}

<div class="container mt-4 p-0">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h1 class="display-5 fw-bold m-0">Rejestr Grobów</h1>
    </div>

    <div class="d-flex flex-column gap-4">
        @foreach (var item in Model)
        {
            <div class="card shadow-sm border-0 rounded-3 hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                    <div>
                        <span class="badge bg-secondary px-2.5 py-1.5 rounded-3 small mb-2 d-inline-block opacity-75 fw-bold" style="font-size: 11px;">Grób</span>
                        <h4 class="fw-bold mb-1">Grób nr #@item.Id</h4>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-geo-alt me-1"></i> Działka: @item.PlotId | Głębokość: @(item.BurialDepth?.Depth ?? "Brak")
                        </p>
                    </div>

                    <div class="d-flex align-items-center">
                        <span class="text-muted fw-medium">
                            @if (item.GraveDeceased != null)
                            {
                                @($"{item.GraveDeceased.FirstName} {item.GraveDeceased.Surname}")
                            }
                            else
                            {
                                <span>Brak pochowanego</span>
                            }
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.1) !important;
    }

    .transition {
        transition: all 0.2s ease-in-out;
    }
</style>