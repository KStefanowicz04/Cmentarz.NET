@model ProjektCmentarz.Models.Grave

@{
    ViewData["Title"] = "Szczegóły Grobu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Szczegóły grobu nr #@Model.Id</h1>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Powrót do listy</a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning rounded-pill px-4 ms-2">Edytuj</a>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            

            <div class="row g-4">
                <div class="col-md-4">
                    <p class="text-muted small mb-1">Numer Działki</p>
                    <p class="fw-semibold fs-5">Działka nr @Model.GravePlot?.Id</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted small mb-1">Osoba pochowana</p>
                    <p class="fw-semibold fs-5">@Model.GraveDeceased?.FirstName @Model.GraveDeceased?.Surname</p>
                </div>
                <div class="col-md-4">
                    <p class="text-muted small mb-1">Głębokość pochówku</p>
                    <p class="fw-semibold fs-5">@Model.BurialDepth?.Depth</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
   
    body.dark-mode .card {
        background-color: #1a1d24 !important;
        color: #e2e8f0 !important;
    }

    body.dark-mode h1, body.dark-mode h5 {
        color: #ffffff !important;
    }

    body.dark-mode .text-muted {
        color: #94a3b8 !important;
    }
</style>