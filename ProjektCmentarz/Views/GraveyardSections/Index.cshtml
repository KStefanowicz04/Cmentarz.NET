@{
    ViewData["Title"] = "Mapa";
}

<h2>Interaktywna mapa cmentarza</h2>

@* Podział na mapę i na legendę do flexboxa *@
<div class="flexbox">
    <h4>Wybierz sekcję cmentarza</h4>
    @* Obrazek przedstawiający mapę cmentarza z pokolorowanymi sekcjami *@
    <svg viewBox="0 0 1312 1628" width="50%" class="map">
        <image href="Content/Images/MapaCmentarzaSektory.png" width="1312" height="1628" fill-opacity="0" />

        @* Sekcja Chrześcijańska *@
        <a asp-action="Details" asp-route-id="1">
            <polygon points="122,512 534,257 545,291 393,635 509,792 381,882" fill-opacity="0" />
        </a>
        @* Sekcja Protestancka *@
        <a asp-action="Details" asp-route-id="2">
            <polygon points="752,876,1076,650,1173,773,1170,807,888,1028" fill-opacity="0" />
        </a>
        @* Sekcja Żołnierzy Radzieckich *@
        <a asp-action="Details" asp-route-id="3">
            <polygon points="700,1064,800,972,868,1060,768,1124" fill-opacity="0" />
        </a>
        @* Sekcja Islamska *@
        <a asp-action="Details" asp-route-id="4">
            <polygon points="570,1178,686,1084,900,1368,800,1466" fill-opacity="0"/>
        </a>
        @* Sekcja Czwartkicka *@
        <a asp-action="Details" asp-route-id="5">
            <polygon points="594,852,674,814,782,964,706,1024" fill-opacity="0" />
        </a>
        @* Sekcja Buddyska *@
        <a asp-action="Details" asp-route-id="6">
            <polygon points="542,249,761,126,923,256,878,360,807,370,780,336,688,393,613,314,562,302" fill-opacity="0" />
        </a>
        @* Sekcja Konfuzjańska *@
        <a asp-action="Details" asp-route-id="7">
            <polygon points="398,900,526,800,690,1030,555,1158" fill-opacity="0" />
        </a>
        @* Sekcja Chińska *@
        <a asp-action="Details" asp-route-id="8">
            <polygon points="560,630,726,518,914,744,730,866" fill-opacity="0" />
        </a>
        @* Sekcja Prawosławna *@
        <a asp-action="Details" asp-route-id="9">
            <polygon points="732,500,888,400,1076,634,920,740" fill-opacity="0" />
        </a>
    </svg>

    <h4>Lista sekcji cmentarza</h4>
    <ul class="list">
        <li style="background:#0063e8;">
            <a asp-action="Details" asp-route-id="1">Sekcja Chrześcijańska</a>
        </li>
        <li style="background:#1db003;">
            <a asp-action="Details" asp-route-id="2">Sekcja Protestancka</a>
        </li>
        <li style="background:#cc141e;">
            <a asp-action="Details" asp-route-id="3">Sekcja Żołnierzy Radzieckich</a>
        </li>
        <li style="background:#cbd709;">
            <a asp-action="Details" asp-route-id="4">Sekcja Islamska</a>
        </li>
        <li style="background:#87e331;">
            <a asp-action="Details" asp-route-id="5">Sekcja Czwartkicka</a>
        </li>
        <li style="background:#1bd6d2;">
            <a asp-action="Details" asp-route-id="6">Sekcja Buddyska</a>
        </li>
        <li style="background:#a020d1;">
            <a asp-action="Details" asp-route-id="7">Sekcja Konfuzjańska</a>
        </li>
        <li style="background:#cf1738;">
            <a asp-action="Details" asp-route-id="8">Sekcja Chińska</a>
        </li>
        <li style="background:#dc8911;">
            <a asp-action="Details" asp-route-id="9">Sekcja Prawosławna</a>
        </li>
    </ul>
</div>

<style>
    .flexbox {
        display: flex;
        align-items: flex-start;
        gap: 30px;
    }

    .map {
        flex: 0 0 40%;
    }

    .list {
        margin: 0;
        padding-left: 20px;
    }

    /* Żeby tło nie wylewało się poza tekst */
    ul li {
        width: fit-content;
        margin: 4px;
        padding: 2px;
    }
    /* Linki */
    ul li a {
        display: block;
        color: black;
    }
    ul li a:hover,
    ul li a:focus,
    ul li a:active {
        color: white;
    }
</style>