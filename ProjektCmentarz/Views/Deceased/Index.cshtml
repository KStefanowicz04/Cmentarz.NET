@model X.PagedList.IPagedList<ProjektCmentarz.Models.Deceased>

@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Lista Zmarłych";
}

<h1>Ewidencja zmarłych</h1>

@* ---  Licznik rekordów --- *@
<div class="alert alert-secondary">
    Liczba osób w bazie: <strong>@Model.TotalItemCount</strong>
</div>

@* --- PANEL GENEROWANIA RAPORTU EXCEL (TYLKO DLA ADMINA) --- *@
@if (User.IsInRole("Admin"))
{
    <div class="card mb-4 shadow-sm" style="border-left: 5px solid #198754;">
        <div class="card-body bg-light">
            <h5 class="text-success mb-3"><i class="fas fa-file-excel"></i> Generowanie Raportu Miesięcznego</h5>

            <form asp-controller="Report" asp-action="DownloadMonthlyReport" method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Wybierz miesiąc</label>
                    <select name="month" class="form-select">
                        <option value="1" selected>Styczeń</option>
                        <option value="2">Luty</option>
                        <option value="3">Marzec</option>
                        <option value="4">Kwiecień</option>
                        <option value="5">Maj</option>
                        <option value="6">Czerwiec</option>
                        <option value="7">Lipiec</option>
                        <option value="8">Sierpień</option>
                        <option value="9">Wrzesień</option>
                        <option value="10">Październik</option>
                        <option value="11">Listopad</option>
                        <option value="12">Grudzień</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Wpisz rok (dowolny z bazy)</label>
                    <input type="number" name="year" class="form-control" value="@DateTime.Now.Year" min="1900" max="2100" required />
                </div>

                <div class="col-md-3 d-flex align-items-end" style="height: 58px;">
                    <button type="submit" class="btn btn-success w-100">
                        Pobierz Excel (.xlsx)
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@* --- Formularz wyszukiwania --- *@
<div class="card mb-4 shadow-sm">
    <div class="card-body bg-light">
        <form asp-action="Index" method="get">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Imię lub Nazwisko</label>
                    <input type="text" name="searchString" class="form-control" placeholder="Wpisz frazę..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Data urodzenia</label>
                    <input type="date" name="searchDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Data zgonu</label>
                    <input type="date" name="searchDeathDate" class="form-control" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Szukaj</button>
                </div>
            </div>
            <div class="mt-2 text-end">
                <a asp-action="Index" class="btn btn-sm btn-link text-secondary">Wyczyść filtry</a>
            </div>
        </form>
    </div>
</div>

<p>
    @* --- TYLKO ADMIN może widzieć dodawać nowego zmarłego --- *@
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">Dodaj nową osobę</a>
    }
</p>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].FirstName)</th>
            <th>@Html.DisplayNameFor(m => m[0].Surname)</th>
            <th>@Html.DisplayNameFor(m => m[0].BirthDate)</th>
            <th>@Html.DisplayNameFor(m => m[0].DeathDate)</th>
            <th>@Html.DisplayNameFor(m => m[0].CasketId)</th>
            <th>@Html.DisplayNameFor(m => m[0].FuneralId)</th>
            <th>Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                <td>@item.BirthDate.ToShortDateString()</td>
                <td>@item.DeathDate.ToShortDateString()</td>
                <td>@Html.DisplayFor(modelItem => item.CasketId)</td>
                <td>@Html.DisplayFor(modelItem => item.FuneralId)</td>
                <td>
                    @* --- TYLKO ADMIN może widzieć "Edit" --- *@
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a> @:|
                    }

                    @* KAŻDY może widzieć "Details" *@
                    <a asp-action="Details" asp-route-id="@item.Id">Profil</a>

                    @* --- TYLKO ADMIN może widzieć "Delete" --- *@
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="mx-1">|</span>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">Usuń</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.PagedListPager(
    Model,
    page => Url.Action("Index", new
    {
        page,
        searchString = Context.Request.Query["searchString"],
        searchDate = Context.Request.Query["searchDate"],
        searchDeathDate = Context.Request.Query["searchDeathDate"]
    }),
    new PagedListRenderOptions
    {
        DisplayLinkToFirstPage = PagedListDisplayMode.Always,
        DisplayLinkToLastPage = PagedListDisplayMode.Always,
        DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
        DisplayLinkToNextPage = PagedListDisplayMode.Always,
        MaximumPageNumbersToDisplay = 5,
        UlElementClasses = new[] { "pagination" },
        LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" }
    }
)