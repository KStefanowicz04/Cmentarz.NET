@model X.PagedList.IPagedList<ProjektCmentarz.Models.Deceased>
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Ewidencja Zmarłych";
}

<div class="container p-0 mt-4">
    
    <!-- NAGŁÓWEK STRONY -->
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4 flex-wrap gap-3">
        <div>
            <h1 class="display-5 text-dark fw-bold m-0" style="color: inherit !important;">Ewidencja Zmarłych</h1>
            <p class="text-muted small m-0 mt-1">
                Liczba zarejestrowanych osób w systemie: <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill fw-bold">@Model.TotalItemCount</span>
            </p>
        </div>
        
        @if (User.IsInRole("Admin"))
        {
            <div>
                <a asp-action="Create" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Dodaj nową osobę
                </a>
            </div>
        }
    </div>

    <!-- PANEL GENEROWANIA RAPORTU EXCEL (TYLKO DLA ADMINA) -->
    @if (User.IsInRole("Admin"))
    {
        <div class="card mb-4 border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body bg-body-tertiary p-4" style="border-left: 4px solid #198754;">
                <h5 class="text-success fw-bold mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-excel fs-5"></i> Generowanie Raportu Miesięcznego
                </h5>

                <form asp-controller="Report" asp-action="DownloadMonthlyReport" method="get" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small fw-bold text-muted">Wybierz miesiąc</label>
                        <select name="month" class="form-select rounded-3">
                            <option value="1" selected>Styczeń</option>
                            <option value="2">Luty</option>
                            <option value="3">Marzec</option>
                            <option value="4">Kwiecień</option>
                            <option value="5">Maj</option>
                            <option value="6">Czerwiec</option>
                            <option value="7">Lipiec</option>
                            <option value="8">Sierpień</option>
                            <option value="9">Wrzesień</option>
                            <option value="10">Październik</option>
                            <option value="11">Listopad</option>
                            <option value="12">Grudzień</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Wpisz rok</label>
                        <input type="number" name="year" class="form-control rounded-3" value="2026" min="1900" max="2100" required />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-semibold shadow-sm">
                            Pobierz arkusz (.xlsx)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- FORMULARZ WYSZUKIWANIA  -->
    <div class="card mb-4 border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body bg-body-tertiary p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Imię lub Nazwisko</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="background-color: transparent !important;"><i class="bi bi-search"></i></span>
                            <input type="text" name="searchString" class="form-control border-start-0 rounded-end-3" placeholder="Wpisz frazę..." value="@Context.Request.Query["searchString"]" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Data urodzenia</label>
                        <input type="date" name="searchDate" class="form-control rounded-3" value="@Context.Request.Query["searchDate"]" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-muted">Data zgonu</label>
                        <input type="date" name="searchDeathDate" class="form-control rounded-3" value="@Context.Request.Query["searchDeathDate"]" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold shadow-sm">Szukaj</button>
                    </div>
                </div>
                <div class="mt-3 text-end">
                    <a asp-action="Index" class="btn btn-sm btn-link link-secondary text-decoration-none small"><i class="bi bi-x-circle me-1"></i> Wyczyść wszystkie filtry</a>
                </div>
            </form>
        </div>
    </div>

    <!-- TABELA DANYCH -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="color: inherit;">
                <thead class="border-bottom">
                    <tr>
                        <th class="py-3 px-4 fw-bold">Imię</th>
                        <th class="py-3 px-4 fw-bold">Nazwisko</th>
                        <th class="py-3 px-4 fw-bold"><i class="bi bi-calendar-event me-1"></i> Data urodzenia</th>
                        <th class="py-3 px-4 fw-bold"><i class="bi bi-calendar-x me-1"></i> Data zgonu</th>
                        <th class="py-3 px-4 fw-bold">Nr Trumny</th>
                        <th class="py-3 px-4 fw-bold">ID Pogrzebu</th>
                        <th class="py-3 px-4 fw-bold text-end">Zarządzaj</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                Brak rekordów spełniających kryteria wyszukiwania.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom" style="color: inherit;">
                                <td class="py-3 px-4 fw-semibold">@Html.DisplayFor(modelItem => item.FirstName)</td>
                                <td class="py-3 px-4 fw-semibold">@Html.DisplayFor(modelItem => item.Surname)</td>
                                <td class="py-3 px-4 text-muted">@item.BirthDate.ToShortDateString()</td>
                                <td class="py-3 px-4 text-muted">@item.DeathDate.ToShortDateString()</td>
                                <td class="py-3 px-4"><span class="deceased-id">#@item.CasketId</span></td>
                                <td class="py-3 px-4"><span class="deceased-id">#@item.FuneralId</span></td>
                                <td class="py-3 px-4 text-end">
                                    <div class="btn-group gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size: 13px;">
                                            Profil
                                        </a>
                                        
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Edytuj">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-2" title="Usuń">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- STRONICOWANIE  -->
    <div class="d-flex justify-content-center mt-4">
        @Html.PagedListPager(
            Model,
            page => Url.Action("Index", new
            {
                page,
                searchString = Context.Request.Query["searchString"],
                searchDate = Context.Request.Query["searchDate"],
                searchDeathDate = Context.Request.Query["searchDeathDate"]
            }),
            new PagedListRenderOptions
            {
                DisplayLinkToFirstPage = PagedListDisplayMode.Never,
                DisplayLinkToLastPage = PagedListDisplayMode.Never,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 5,
                UlElementClasses = new[] { "pagination", "pagination-sm", "gap-1" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link", "rounded-3", "px-3" }
            }
        )
    </div>
</div>
<style>
    /* PAGINACJA */
    .pagination .page-item .page-link {
        color: #475569;
        border: 1px solid #e2e8f0;
        background-color: #ffffff;
    }

    .pagination .page-item.active .page-link {
        background-color: #475569 !important;
        border-color: #475569 !important;
        color: #ffffff !important;
    }

    .deceased-id {
        display: inline-block;
        padding: 8px 16px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        color: #0f172a;
        background-color: #ffffff;
        font-weight: 600;
    }
   
    /* DARK MODE */

    body.dark-mode .deceased-id {
        background-color: #1e293b;
        border-color: #334155;
        color: #e2e8f0;
    }

    body.dark-mode .card,
    body.dark-mode .card-body {
        background-color: #111827 !important;
        border-color: #1f2937 !important;
        color: #e2e8f0 !important;
    }

    /* Inputy i selecty */
    body.dark-mode .form-control,
    body.dark-mode .form-select,
    body.dark-mode .input-group-text {
        background-color: #1e293b !important;
        border-color: #334155 !important;
        color: #e2e8f0 !important;
    }

        body.dark-mode .form-control::placeholder {
            color: #94a3b8 !important;
        }

        body.dark-mode .form-control:focus,
        body.dark-mode .form-select:focus {
            background-color: #1e293b !important;
            color: #e2e8f0 !important;
            border-color: #3b82f6 !important;
            box-shadow: none;
        }

    /* Tabela */
    body.dark-mode .table {
        color: #e2e8f0 !important;
    }

        body.dark-mode .table thead {
            background-color: #1f2937 !important;
        }

        body.dark-mode .table th {
            color: #cbd5e1 !important;
            border-color: #334155 !important;
        }

        body.dark-mode .table td {
            border-color: #334155 !important;
        }

        body.dark-mode .table tbody tr {
            background-color: #111827 !important;
        }

    body.dark-mode .table-hover tbody tr:hover {
        background-color: #1e293b !important;
    }

    /* Badge (#ID) */
    body.dark-mode .badge.bg-light {
        background-color: #1e293b !important;
        color: #e2e8f0 !important;
        border: 1px solid #334155 !important;
    }

    /* Link "Wyczyść filtry" */
    body.dark-mode .link-secondary,
    body.dark-mode .text-muted {
        color: #94a3b8 !important;
    }

    /* Paginacja */
    body.dark-mode .pagination .page-item .page-link {
        background-color: #1a1d24;
        border-color: #2d323f;
        color: #94a3b8;
    }

    body.dark-mode .pagination .page-item.active .page-link {
        background-color: #475569 !important;
        border-color: #475569 !important;
        color: #ffffff !important;
    }

    /* Naprawa bg-body-tertiary */
    body.dark-mode .bg-body-tertiary {
        background-color: #111827 !important;
    }

    
    body.dark-mode .table-light {
        background-color: #1f2937 !important;
        color: #e2e8f0 !important;
    }

        body.dark-mode .table-light th {
            background-color: #1f2937 !important;
            color: #e2e8f0 !important;
        }

   
    body.dark-mode .input-group-text i {
        color: #94a3b8;
    }
</style>