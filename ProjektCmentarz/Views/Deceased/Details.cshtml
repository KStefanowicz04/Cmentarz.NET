@model ProjektCmentarz.Models.Deceased
@{
    var grave = ViewBag.Grave as Grave;
    var certificate = ViewBag.Certificate as DeathCertificate;
}


@{
    ViewData["Title"] = "Details";
}

<h1>Nieboszczyk #@Html.DisplayFor(model => model.Id)</h1>
<hr />

<div>
    <dl class="row">
        @* Dane *@
        <h4>Dane</h4>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName) i 
             @Html.DisplayNameFor(model => model.Surname)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FirstName)
             @Html.DisplayFor(model => model.Surname)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(_ => certificate.CauseOfDeath.Cause)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => certificate.CauseOfDeath.Cause)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(_ => certificate.Issuer.FuneralHomeName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => certificate.Issuer.FuneralHomeName)
        </dd>

        <h4>Daty</h4>
        @* Daty *@
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BirthDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BirthDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DeathDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DeathDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(_ => certificate.IssueDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => certificate.IssueDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Funeral.FuneralDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Funeral.FuneralDate)
        </dd>
        <dt class="col-sm-2">
            Data instalacji nagrobka
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => grave.GraveGravestone.InstallationDate)
        </dd>

        @* Grób *@
        <h4>Grób</h4>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(_ => grave.GraveGravestone.GravestoneInscryption.Inscryption)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => grave.GraveGravestone.GravestoneInscryption.Inscryption)
        </dd>
        <dt class="col-sm-2">
            Numer działki
        </dt>
        <dd class="col-sm-10">
            <a asp-controller="Plots" asp-action="Details" asp-route-id="@grave.PlotId" class="text-danger">
                @Html.DisplayFor(_ => grave.PlotId)</a>
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(_ => grave.BurialDepth.Depth)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => grave.BurialDepth.Depth)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(_ => grave.GraveGravestone.Material.Type)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(_ => grave.GraveGravestone.Material.Type)
        </dd>

        @* Trumna *@
        <h4>Trumna</h4>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Casket.Material)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Casket.Material.Type)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Casket.Price)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Casket.Price)zł
        </dd>

        @* Pogrzeb *@
        <h4>Pogrzeb</h4>
        <dt class="col-sm-2">
            Ksiądz wykonujący
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Funeral.FuneralPriest.FirstName)
            @Html.DisplayFor(model => model.Funeral.FuneralPriest.Surname)
        </dd>
        @if (Model.Funeral.FuneralGravekeepers.Any())
        {
           <dt class="col-sm-2">
               Grabarze
           </dt>
           foreach (var gravekpr in Model.Funeral.FuneralGravekeepers)
           {
               <dd class="col-sm-10">
                   @gravekpr.FirstName @gravekpr.Surname
               </dd>
           }
        }
           
       
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
